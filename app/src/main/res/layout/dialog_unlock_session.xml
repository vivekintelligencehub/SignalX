<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_input_normal">

        <EditText
            android:id="@+id/etUnlockSessionPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Password"
            android:textSize="13sp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:inputType="textPassword"
            android:singleLine="true"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/ivToggleUnlockSessionPassword"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="👁"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvUnlockSessionError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="#F44336"
        android:visibility="gone"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/btnUnlockSession"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="UNLOCK"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:background="@drawable/bg_sync_button"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnUseFingerprintSession"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="Use Fingerprint"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:includeFontPadding="false" />

</LinearLayout>