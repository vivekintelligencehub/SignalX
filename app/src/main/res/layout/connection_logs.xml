<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#111111">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#1A1A1A"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tv_logs_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="LOGS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnExpandLogs"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_expand"
            android:contentDescription="Expand"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnDeleteLogs"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnExpandLogs"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="Delete logs"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="#111111"
        android:fillViewport="true"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tv_logs_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="[09:20:15] Logs screen cleared."
            android:textColor="#4CAF50"
            android:textSize="9sp"
            android:fontFamily="monospace" />

    </ScrollView>

</LinearLayout>