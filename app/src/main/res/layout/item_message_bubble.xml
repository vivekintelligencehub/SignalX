<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_message_bubble"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:text="Message"
            android:textSize="13sp"
            android:textColor="#222222"
            android:includeFontPadding="false" />

        <!-- Single image (adapter control karega visibility) -->
        <ImageView
            android:id="@+id/ivSingleImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Image" />

        <!-- Dynamic grid container (adapter iske andar images add karega) -->
        <FrameLayout
            android:id="@+id/imageGridContainer"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Caption — sirf IMG:: messages ke liye -->
        <TextView
            android:id="@+id/tvMessageCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="260dp"
            android:textSize="13sp"
            android:textColor="#222222"
            android:includeFontPadding="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:text="12:00"
            android:textSize="9sp"
            android:textColor="#666666"
            android:includeFontPadding="false" />

    </LinearLayout>

</LinearLayout>