<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/btnBackUnlock"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#222222"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Locked Chats"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:includeFontPadding="false" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🔒"
                android:textSize="34sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Enter Password"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_input_normal">

                <EditText
                    android:id="@+id/etUnlockPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Password"
                    android:textSize="13sp"
                    android:textColor="#222222"
                    android:textColorHint="#999999"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:gravity="center"
                    android:background="@android:color/transparent" />

                <TextView
                    android:id="@+id/ivToggleUnlockPassword"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="👁"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvUnlockError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text=""
                android:textSize="11sp"
                android:textColor="#F44336"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnUnlockWithPassword"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="UNLOCK"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:background="@drawable/bg_sync_button"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/btnUseFingerprint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:text="Use Fingerprint"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:clickable="true"
        android:focusable="true"
        android:includeFontPadding="false" />

</LinearLayout>