<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- TARGET IP -->
    <EditText
        android:id="@+id/etIpAddress"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginBottom="4dp"
        android:hint="Target IP"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:textColorHint="#777777"
        android:singleLine="true"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_input_normal" />

    <!-- PORT -->
    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginBottom="4dp"
        android:hint="Port"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:textColorHint="#777777"
        android:singleLine="true"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_input_normal" />

    <!-- OWNER / CLIENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- OWNER -->
        <FrameLayout
            android:id="@+id/lanOwner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_performance_selected"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="OWNER"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:includeFontPadding="false" />

        </FrameLayout>

        <!-- CLIENT -->
        <FrameLayout
            android:id="@+id/lanClient"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_performance_normal"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="CLIENT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:includeFontPadding="false" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>